@page "{id:int}"
@model BingoGameOnline.Server.Pages.Rooms.JoinModel
@{
    ViewData["Title"] = "Join Room";
}

<div class="row">
    <div class="col-md-9">
        <h1>Room: @Model.Room?.Name</h1>
        <!-- Game area or other content can go here -->
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-header bg-primary text-white">
                Players in this room
            </div>
            <div class="card-body" id="player-list-section">
                <ul class="list-group list-group-flush">
                    @foreach (var name in Model.PlayerNames)
                    {
                        if (name == Model.DisplayName)
                        {
                            <li class="list-group-item fw-bold text-primary">@name</li>
                        }
                        else
                        {
                            <li class="list-group-item">@name</li>
                        }
                    }
                </ul>
            </div>
        </div>
        <div class="card mt-4">
            <div class="card-header bg-secondary text-white">
                Room Chat
            </div>
            <div class="card-body" style="height: 250px; overflow-y: auto;" id="chat-messages">
                <!-- Chat messages will appear here -->
            </div>
            <div class="card-footer">
                <form id="chat-form" onsubmit="return false;">
                    <div class="input-group">
                        <input type="text" id="chat-input" class="form-control" placeholder="Type a message..." autocomplete="off" />
                        <button type="submit" class="btn btn-primary">Send</button>
                    </div>
                </form>
            </div>
        </div>
        <form method="post" class="mt-3">
            <button type="submit" class="btn btn-danger w-100">Leave Room</button>
        </form>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/roomplayers.js"></script>
    <script src="~/js/roomchat.js"></script>
}
