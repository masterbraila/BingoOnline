@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@if (Model.ShowEmailReminder)
{
    <div class="alert alert-warning text-center mt-4" role="alert">
        <strong>Email not confirmed!</strong> Please check your inbox and confirm your email address.<br />
        Your account will be deleted in <strong>@Model.DaysLeft day@(Model.DaysLeft == 1 ? "" : "s")</strong> if not confirmed.
        <br />
        <a href="/Identity/Account/Manage" class="btn btn-sm btn-primary mt-2">Resend confirmation email</a>
    </div>
}

<div class="d-flex justify-content-between align-items-start d-flex-main">
    <div style="flex-grow:1">
        <div class="text-center">
            <h1 class="display-4">Bingo Online</h1>
            <p>Welcome <strong>@Model.DisplayName</strong> to Bingo Online, the ultimate platform for playing and enjoying bingo games from the comfort of your home!</p>
            <p>To play the game you need to go into the <a href="/Rooms">Rooms</a> page and create your own room or join an existing one.</p>
        </div>
    </div>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="friends-sidebar">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span>Friends</span>
                    <button id="open-add-friend-modal" type="button" class="btn btn-sm btn-light text-primary fw-bold add-friend-btn-style" title="Add Friend">+</button>
                </div>
                <div class="card-body">
                    <h6 class="mb-2">Your Friends</h6>
                    <ul id="friends-list" class="list-group">
                        <li class="list-group-item text-muted">(No friends yet)</li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Friend Modal -->
<div class="modal fade" id="addFriendModal" tabindex="-1" aria-labelledby="addFriendModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="addFriendModalLabel">Add Friend</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="input-group mb-2">
          <input type="text" id="modal-friend-search-box" class="form-control" placeholder="Search users..." autocomplete="off" />
          <button class="btn btn-primary" id="modal-friend-search-btn" type="button">Search</button>
        </div>
        <ul id="modal-friend-search-results" class="list-group"></ul>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script src="/js/index.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script type="module" src="/js/presence.js"></script>
<script type="module" src="/js/friendshub.js"></script>
<script type="module" src="/js/userchathub.js"></script>
}
