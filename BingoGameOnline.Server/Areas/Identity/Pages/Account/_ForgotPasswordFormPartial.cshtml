@model BingoGameOnline.Server.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    var input = Model?.Input as BingoGameOnline.Server.Areas.Identity.Pages.Account.ForgotPasswordModel.InputModel ?? new BingoGameOnline.Server.Areas.Identity.Pages.Account.ForgotPasswordModel.InputModel();
}
<form id="forgotForm" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" value="@(input?.Email ?? string.Empty)" />
        <label asp-for="Input.Email" class="form-label"></label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <button type="submit" class="w-100 btn btn-lg btn-primary">Reset Password</button>
</form>
<partial name="_ValidationScriptsPartial" />
