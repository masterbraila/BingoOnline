@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}
@if (Request.Query["layout"] == "none")
{
    @await Html.PartialAsync("_ForgotPasswordFormPartial", Model)
}
else
{
    <h1>@ViewData["Title"]</h1>
    <h2>Enter your email.</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            @await Html.PartialAsync("_ForgotPasswordFormPartial", Model)
        </div>
    </div>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
