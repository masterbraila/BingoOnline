@page
@model RegisterModel
@{
    if (Model == null)
    {
        throw new InvalidOperationException("RegisterModel is null. The partial must be called with a model instance.");
    }
    ViewData["Title"] = "Register";
    var noLayout = Request.Query["layout"] == "none";
    Layout = noLayout ? null : "~/Pages/Shared/_Layout.cshtml";
}
@if (noLayout)
{
    <div class="p-4">
        @await Html.PartialAsync("_RegisterFormPartial", Model)
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <h2>Create a new account.</h2>
            <hr />
            @await Html.PartialAsync("_RegisterFormPartial", Model)
        </div>
    </div>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
